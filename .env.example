# ---------------------------------------------------------------------------
# KINETIC — plantilla de variables de entorno.
#
# COPIA este archivo como  .env  y pega ahi tus llaves reales.
# El archivo  .env  esta en .gitignore: nunca se sube a git. Este  .env.example
# si se versiona, pero solo con los espacios en blanco que ves abajo.
#
# NADIE debe pedirte estas llaves por chat, ni Claude. Las pegas vos, a mano,
# en tu propio archivo .env.
# ---------------------------------------------------------------------------

# --- Binance TESTNET (dinero de mentira) -----------------------------------
# Se sacan en https://testnet.binance.vision/ entrando con GitHub.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Binance MAINNET (dinero real) — Fase 3, NO completar todavia ----------
# Cuando llegue el momento, la llave debe crearse con:
#   [x] Enable Reading
#   [x] Enable Spot & Margin Trading
#   [ ] Enable Withdrawals   <-- APAGADO, sin excepcion
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram (opcional, para alertas) -------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
